# Copy to `.env` — never commit `.env`

MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB_NAME=healthcare_dev

APP_ENV=development
LOG_LEVEL=INFO
SESSION_TIMEOUT_MINUTES=480

# Facility identity (distributed demo)
FACILITY_ID=HQ-MAIN
FACILITY_NAME=Main Campus
SYNC_API_KEY=change-me-sync-key
SYNC_API_PORT=8100
SYNC_PEER_URLS=

# MONGODB_USERNAME=
# MONGODB_PASSWORD=
