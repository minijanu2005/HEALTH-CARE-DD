# Secrets — never commit real credentials
.env

# Virtual environment
.venv/
venv/
ENV/

# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / editor
.idea/
.vscode/
*.swp

# Streamlit local secrets (if used later)
.streamlit/secrets.toml

# Database dumps and local backup archives (keep folder, ignore contents)
backups/*
!backups/.gitkeep

# Legacy SQLite file (not used for MongoDB; keep local only)
healthcare.db

# OS files
Thumbs.db
Desktop.ini
.DS_Store
